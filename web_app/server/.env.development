# for local development, not for production

MESH3D_ENV=development
MESH3D_ADDR=:8080
MESH3D_STORAGE_DIR=storage
MESH3D_CLIENT_DIR=../client/dist

POSTGRES_USER=mesh3d
POSTGRES_PASSWORD=mesh3d_dev
POSTGRES_DB=mesh3d
MESH3D_DATABASE_URL=postgres://mesh3d:mesh3d_dev@localhost:5432/mesh3d?sslmode=disable

MESH3D_JWT_SECRET=mesh3d_dev_jwt_secret_change_me
MESH3D_ML_URL=http://127.0.0.1:8090
MESH3D_ML_API_KEY=mesh3d_ml_dev_key
